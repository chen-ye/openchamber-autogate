{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": false,
    "types": ["bun", "node"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": [
    "shared/**/*.ts",
    "service/**/*.ts",
    "panel/**/*.ts",
    "status/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "service/main.js",
    "panel/main.js",
    "status/main.js"
  ]
}
